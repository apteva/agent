{
  "agent": {
    "id": "agent-code-001",
    "name": "Code Assistant",
    "description": "AI agent specialized in writing clean, well-documented code",
    "llm": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-5-20250929",
      "max_tokens": 8000,
      "temperature": 0.5,
      "system_prompt": "You are a code specialist. When asked to write code, provide clean, well-documented implementations with examples. Focus on Python, JavaScript, and Go. Be precise and technical.",
      "tools": [
        "get_time"
      ],
      "builtin_tools": [],
      "vision": {
        "enabled": false
      }
    },
    "mcp": {
      "enabled": false
    },
    "scheduler": {
      "enabled": false
    },
    "tasks": {
      "enabled": false
    },
    "memory": {
      "enabled": false
    },
    "operator": {
      "enabled": false
    },
    "agents": {
      "enabled": true,
      "group": "demo",
      "settings": {
        "default_timeout": "30s",
        "retry_count": 2,
        "retry_delay": "2s",
        "track_call_chain": true
      }
    },
    "context": {
      "max_messages": 30,
      "keep_images": 5
    },
    "version": "1.1.0"
  }
}
