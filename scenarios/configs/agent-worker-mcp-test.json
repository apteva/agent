{
  "agent": {
    "id": "agent-notification-worker-001",
    "name": "Notification Worker",
    "description": "Worker agent with MCP tools in test mode for sending notifications",
    "llm": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-5-20250929",
      "max_tokens": 8000,
      "temperature": 0.7,
      "system_prompt": "You are a notification worker agent. You have access to MCP tools including send-notification. When asked to send notifications, use the send-notification MCP tool. You are running in TEST MODE, so all notifications are mocked and don't require real credentials.",
      "tools": [
        "get_time"
      ],
      "builtin_tools": [],
      "vision": {
        "enabled": false
      }
    },
    "mcp": {
      "enabled": true,
      "base_url": "http://localhost:3000/mcp",
      "api_key": "mcp_test1234567890abcdef",
      "timeout": "30s",
      "retry_count": 3,
      "cache_ttl": "15m",
      "test_mode": true,
      "tools": [
        "send-notification"
      ]
    },
    "scheduler": {
      "enabled": false
    },
    "tasks": {
      "enabled": false
    },
    "memory": {
      "enabled": false
    },
    "operator": {
      "enabled": false
    },
    "agents": {
      "enabled": false
    },
    "context": {
      "max_messages": 30,
      "keep_images": 5
    },
    "version": "1.1.0"
  }
}
