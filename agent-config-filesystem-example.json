{
  "agent": {
    "id": "filesystem-example",
    "name": "Agent with File System",
    "description": "Example configuration showing filesystem enabled",
    "llm": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-5",
      "max_tokens": 4000,
      "temperature": 0.7,
      "system_prompt": "You are a helpful AI assistant with file storage capabilities.",
      "vision": {
        "enabled": true,
        "max_images": 20,
        "max_image_size": 5242880,
        "allowed_types": ["jpeg", "png", "gif", "webp"],
        "resize_images": true,
        "max_dimension": 1568,
        "pdf": {
          "enabled": true,
          "max_file_size": 33554432,
          "max_pages": 100,
          "allow_urls": true
        }
      }
    },
    "context": {
      "max_messages": 30,
      "keep_images": 5
    },
    "filesystem": {
      "enabled": true,
      "max_file_size": 10485760,
      "max_total_size": 104857600,
      "auto_extract": true,
      "min_extract_size": 10240,
      "deduplication": true,
      "auto_cleanup": true,
      "retention_days": 7,
      "cleanup_orphans": true,
      "allowed_types": ["image", "document"]
    }
  }
}
