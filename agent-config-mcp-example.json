{
  "agent": {
    "name": "AI Assistant with MCP",
    "description": "AI assistant with MCP server integration",
    "llm": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-20250514",
      "max_tokens": 4000,
      "temperature": 0.7,
      "tools": ["get_time", "send_notification"],
      "builtin_tools": [
        {
          "type": "web_fetch_20250910",
          "name": "web_fetch",
          "max_uses": 1
        }
      ]
    },
    "mcp": {
      "enabled": true,
      "base_url": "http://localhost:3000/mcp",
      "api_key": "your-mcp-api-key",
      "timeout": "30s",
      "retry_count": 3,
      "cache_ttl": "15m"
    },
    "version": "1.0.0"
  }
}