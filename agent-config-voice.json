{
  "agent": {
    "id": "voice-agent-001",
    "name": "Voice Assistant",
    "description": "AI assistant with voice conversation and tool calling capabilities",
    "llm": {
      "provider": "openai",
      "model": "gpt-realtime",
      "max_tokens": 4000,
      "temperature": 0.7,
      "system_prompt": "You are a helpful AI assistant. Be conversational and friendly. When you use tools, briefly explain what you're doing. Keep responses concise since this is a voice conversation.",
      "tools": [
        "get_time",
        "create_task",
        "list_tasks",
        "send_notification"
      ]
    },
    "mcp": {
      "enabled": true,
      "base_url": "http://localhost:3000/mcp",
      "api_key": "mcp_test1234567890abcdef",
      "timeout": "30s",
      "retry_count": 3,
      "cache_ttl": "15m",
      "test_mode": false,
      "tools": [
        "geocode",
        "get-weather"
      ]
    },
    "realtime": {
      "enabled": true,
      "voice": "marin",
      "vad_type": "semantic_vad"
    },
    "tasks": {
      "enabled": true,
      "allow_scheduling": true,
      "allow_recurring": true,
      "max_tasks": 100,
      "auto_execute": false
    },
    "version": "1.0.0"
  }
}
